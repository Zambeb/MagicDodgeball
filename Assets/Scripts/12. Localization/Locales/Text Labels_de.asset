  m_SharedData: {fileID: 11400000, guid: 5e3606aab6cada1438b40f190db374c4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 130866249728
    m_Localized: Rammy
    m_Metadata:
      m_Items: []
  - m_Id: 367328526336
    m_Localized: Benny
    m_Metadata:
      m_Items: []
  - m_Id: 496685056000
    m_Localized: "W\xE4hle deine Arena"
    m_Metadata:
      m_Items: []
  - m_Id: 887346724864
    m_Localized: "Dieses mit Liebe, Schlamm und allem andere was herumlag, erbaute,
      imposante Stadion wird durch pure Entschlossenheit und Rammys Ingenieurskunst
      zusammengehalten.\nDas Publikum? Fragw\xFCrdig.\nDie Stimmung? Makellos."
    m_Metadata:
      m_Items: []
  - m_Id: 1030267633664
    m_Localized: "Diese lange von Zeit und Eichh\xF6rnchen verlassenen Steinruinen
      klangen einst mir dem Echo myster\xF6se Ges\xE4nge und magischer R\xFClpser
      . Nun ist es lediglich ein gro\xDFartiger Ort um Duelle auszuf\xFChren und
      ausversehen Entit\xE4ten zu beschw\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 1131039981568
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 1227953569792
    m_Localized: Name Spieler 1
    m_Metadata:
      m_Items: []
  - m_Id: 1319242596352
    m_Localized: Name Spieler 2
    m_Metadata:
      m_Items: []
  - m_Id: 1381280546816
    m_Localized: Unentschieden!
    m_Metadata:
      m_Items: []
  - m_Id: 10462284251136
    m_Localized: gewinnt die Runde!
    m_Metadata:
      m_Items: []
  - m_Id: 10656069484544
    m_Localized: ist der Champion!
    m_Metadata:
      m_Items: []
  - m_Id: 10820108713984
    m_Localized: Finale Runde!
    m_Metadata:
      m_Items: []
  - m_Id: 10906469433344
    m_Localized: Pausiert
    m_Metadata:
      m_Items: []
  - m_Id: 10987302060032
    m_Localized: Weiterspielen
    m_Metadata:
      m_Items: []
  - m_Id: 11041261780992
    m_Localized: "Zum Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 11118176927744
    m_Localized: Bewegen
    m_Metadata:
      m_Items: []
  - m_Id: 11187282280448
    m_Localized: Werfen
    m_Metadata:
      m_Items: []
  - m_Id: 11252029751296
    m_Localized: Zielen
    m_Metadata:
      m_Items: []
  - m_Id: 11310548680704
    m_Localized: "Aktive F\xE4higkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 11368786591744
    m_Localized: Tastatur + Maus
    m_Metadata:
      m_Items: []
  - m_Id: 11430853902336
    m_Localized: Gamepad
    m_Metadata:
      m_Items: []
  - m_Id: 11489460912128
    m_Localized: Linker Mausknopf
    m_Metadata:
      m_Items: []
  - m_Id: 11549493985280
    m_Localized: Leertaste
    m_Metadata:
      m_Items: []
  - m_Id: 11627814223872
    m_Localized: Linker Joystick
    m_Metadata:
      m_Items: []
  - m_Id: 11687817936896
    m_Localized: Rechter Joystick
    m_Metadata:
      m_Items: []
  - m_Id: 11745489616896
    m_Localized: L-Taste
    m_Metadata:
      m_Items: []
  - m_Id: 11806487379968
    m_Localized: R-Taste
    m_Metadata:
      m_Items: []
  - m_Id: 11867141210112
    m_Localized: Defensive
    m_Metadata:
      m_Items: []
  - m_Id: 11932102590464
    m_Localized: Offensive
    m_Metadata:
      m_Items: []
  - m_Id: 11990655074304
    m_Localized: Aktiv
    m_Metadata:
      m_Items: []
  - m_Id: 12043696242688
    m_Localized: Abklingzeit
    m_Metadata:
      m_Items: []
  - m_Id: 12103003701248
    m_Localized: Sprint
    m_Metadata:
      m_Items: []
  - m_Id: 12180107591680
    m_Localized: "Dr\xFCcke Leertaste um zu spriten w\xE4hrend du Unverwundbar bist"
    m_Metadata:
      m_Items: []
  - m_Id: 12256175489024
    m_Localized: "Dr\xFCcke L-Taste um zu spriten w\xE4hrend du Unverwundbar bist"
    m_Metadata:
      m_Items: []
  - m_Id: 13933255360512
    m_Localized: Kraftfeld
    m_Metadata:
      m_Items: []
  - m_Id: 14038242983936
    m_Localized: "Dr\xFCcke Leertaste um f\xFCr 1.5 Sekunden Unverwundbar zu werden,
      aber deine Geschwindigkeit wird um x0.5 verringert und du kannst nicht werfen"
    m_Metadata:
      m_Items: []
  - m_Id: 14421950496768
    m_Localized: "Dr\xFCcke L-Taste um f\xFCr 1.5 Sekunden Unverwundbar zu werden,
      aber deine Geschwindigkeit wird um x0.5 verringert und du kannst nicht werfen"
    m_Metadata:
      m_Items: []
  - m_Id: 14646878437376
    m_Localized: Magische Barrikade
    m_Metadata:
      m_Items: []
  - m_Id: 14712502517760
    m_Localized: "Dr\xFCcke Leertaste um eine Barrikade vor dir zu erbauen. Nur 2
      Barrikaden k\xF6nnen zur selben Zeit existieren. HP = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 14759189315584
    m_Localized: "Dr\xFCcke L-Taste um eine Barrikade vor dir zu erbauen. Nur 2 Barrikaden
      k\xF6nnen zur selben Zeit existieren. HP = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 15150673068032
    m_Localized: Abwehren
    m_Metadata:
      m_Items: []
  - m_Id: 15290817347584
    m_Localized: "Dr\xFCcke Leertaste vor Aufprall um gegnerische B\xE4lle zur\xFCck
      auf dessen Seite zu bef\xF6rdern"
    m_Metadata:
      m_Items: []
  - m_Id: 15534510604288
    m_Localized: "Dr\xFCcke L-Taste vor Aufprall um gegnerische B\xE4lle zur\xFCck
      auf dessen Seite zu bef\xF6rdern"
    m_Metadata:
      m_Items: []
  - m_Id: 15761443422208
    m_Localized: Tausch
    m_Metadata:
      m_Items: []
  - m_Id: 15843295264768
    m_Localized: "Dr\xFCcke Leertaste um einen Teleport zu beschw\xF6ren, dieser
      deine und dein Gegners Positionen Tauscht"
    m_Metadata:
      m_Items: []
  - m_Id: 16053312454656
    m_Localized: "Dr\xFCcke L-Taste um einen Teleport zu beschw\xF6ren, dieser deine
      und dein Gegners Positionen Tauscht"
    m_Metadata:
      m_Items: []
  - m_Id: 16200658354176
    m_Localized: Beschleunigung nach jedem Aufprall
    m_Metadata:
      m_Items: []
  - m_Id: 16300013027328
    m_Localized: "Deine B\xE4lle werden mit jedem Aufprall schneller"
    m_Metadata:
      m_Items: []
  - m_Id: 16357957337088
    m_Localized: Ball-Absorbierung
    m_Metadata:
      m_Items: []
  - m_Id: 16416090390528
    m_Localized: "Wenn zwei B\xE4lle kollidieren, absorbiert dein neuster Ball den
      anderen und addiert dessen Gr\xF6\xDFe und \xFCbrigen Aufpr\xE4lle zu seinen
      eigenen"
    m_Metadata:
      m_Items: []
  - m_Id: 16479445352448
    m_Localized: "Elektrische Fl\xE4che"
    m_Metadata:
      m_Items: []
  - m_Id: 16627202293760
    m_Localized: "Der letzte Aufprall erzeugt eine elektrische Fl\xE4che diese diejenigen
      Verletzt, diese auf sie treten. Gr\xF6\xDFere B\xE4lle -> Gr\xF6\xDFeren Schadens
      Bereich"
    m_Metadata:
      m_Items: []
  - m_Id: 16728696061952
    m_Localized: Aufgeladener Wurf
    m_Metadata:
      m_Items: []
  - m_Id: 16780051120128
    m_Localized: "Halte Linker Mausknopf um die Geschwindkeit deines n\xE4chsten
      Wurfs zu erh\xF6hen"
    m_Metadata:
      m_Items: []
  - m_Id: 17089708195840
    m_Localized: "Halte R-Taste um die Geschwindkeit deines n\xE4chsten Wurfs zu
      erh\xF6hen"
    m_Metadata:
      m_Items: []
  - m_Id: 17275230650368
    m_Localized: "Explodierende B\xE4lle"
    m_Metadata:
      m_Items: []
  - m_Id: 17339571273728
    m_Localized: "Beim letzten Aufprall explodiert dein Ball in 6 kleine B\xE4lle"
    m_Metadata:
      m_Items: []
  - m_Id: 17404377464832
    m_Localized: Unverwundbarkeit nach einem Treffer
    m_Metadata:
      m_Items: []
  - m_Id: 17471188533248
    m_Localized: "Nachdem du getroffen wurdest bekommst du f\xFCr 1 Sekunden Unverwundbarkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 17542382649344
    m_Localized: "Erh\xF6hung Maximaler Aufpr\xE4lle"
    m_Metadata:
      m_Items: []
  - m_Id: 17605557256192
    m_Localized: "Erh\xF6he die Aufpr\xE4lle deiner B\xE4lle bei 2"
    m_Metadata:
      m_Items: []
  - m_Id: 17707587895296
    m_Localized: "Mehr B\xE4lle"
    m_Metadata:
      m_Items: []
  - m_Id: 17769382576128
    m_Localized: "Erh\xF6he die Anzahl deiner B\xE4lle um 1"
    m_Metadata:
      m_Items: []
  - m_Id: 17829625364480
    m_Localized: Bewegungs Geschwindigkeit
    m_Metadata:
      m_Items: []
  - m_Id: 17886726619136
    m_Localized: "Erh\xF6he deine Bewegungs Geschwindigkeit um 5"
    m_Metadata:
      m_Items: []
  - m_Id: 17943144202240
    m_Localized: Kein Friendly Fire
    m_Metadata:
      m_Items: []
  - m_Id: 18020118069248
    m_Localized: "Deine eigenen B\xE4lle k\xF6nnen dich nicht mehr verletzen"
    m_Metadata:
      m_Items: []
  - m_Id: 18085901533184
    m_Localized: "Ball Gr\xF6\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 18169510789120
    m_Localized: "Erh\xF6he die Gr\xF6\xDFe deiner B\xE4lle um x1.65"
    m_Metadata:
      m_Items: []
  - m_Id: 18228243628032
    m_Localized: Ball Geschwindigkeit
    m_Metadata:
      m_Items: []
  - m_Id: 18284938035200
    m_Localized: "Erh\xF6he die Geschwindigkeit deiner B\xE4lle um 4"
    m_Metadata:
      m_Items: []
  - m_Id: 18340625809408
    m_Localized: Schild
    m_Metadata:
      m_Items: []
  - m_Id: 18397349576704
    m_Localized: "Beschw\xF6re 1 Schild dass um dich herum schwebt und dich vor attacken
      sch\xFCtzt"
    m_Metadata:
      m_Items: []
  - m_Id: 18452504674304
    m_Localized: Verlangsamender Schweif
    m_Metadata:
      m_Items: []
  - m_Id: 18513095589888
    m_Localized: "Deine B\xE4lle hinterlassen einen Schweif der jeden verlangsamt
      der hindurch geht"
    m_Metadata:
      m_Items: []
  - m_Id: 18565755076608
    m_Localized: "Bet\xE4ubung"
    m_Metadata:
      m_Items: []
  - m_Id: 18622529175552
    m_Localized: "Deine B\xE4lle bet\xE4uben deinen Gegner f\xFCr 0.8 Sekunden"
    m_Metadata:
      m_Items: []
  - m_Id: 22562327003136
    m_Localized: "M\xFCll-Idol"
    m_Metadata:
      m_Items: []
  - m_Id: 22623979077632
    m_Localized: "Dr\xFCcken Sie Leertaste, um ein selbstgebautes Idol zu platzieren,
      das Geschosse auf Feinde schleudert. Zerst\xF6rt sich nach 3 Treffern. Abklingzeit
      8s."
    m_Metadata:
      m_Items: []
  - m_Id: 22649002295296
    m_Localized: "Dr\xFCcken Sie Linken Trigger, um ein selbstgebautes Idol zu platzieren,
      die B\xE4lle auf Feinde schleudert. Zerst\xF6rt sich nach 3 Treffern. Abklingzeit
      8s."
    m_Metadata:
      m_Items: []
  - m_Id: 23374415560704
    m_Localized: Ball mit Zielsuche
    m_Metadata:
      m_Items: []
  - m_Id: 23510189375488
    m_Localized: Ihre Ball-Projektile passen ihre Flugrichtung langsam an die Position
      des Feindes an.
    m_Metadata:
      m_Items: []
  - m_Id: 24456181088256
    m_Localized: Schnelligkeit
    m_Metadata:
      m_Items: []
  - m_Id: 24185417793536
    m_Localized: "R\xFCcksto\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 24292196384768
    m_Localized: "Beim Treffer wird der Charakter leicht in die entgegengesetzte
      Richtung zur\xFCckgesto\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 24311666343936
    m_Localized: Doppelschuss
    m_Metadata:
      m_Items: []
  - m_Id: 24361817636864
    m_Localized: "+20%-Chance, sofort einen zweiten Schuss abzufeuern. Der zus\xE4tzliche
      Schuss kostet keine Munition."
    m_Metadata:
      m_Items: []
  - m_Id: 24381560225792
    m_Localized: Letzter Spuck
    m_Metadata:
      m_Items: []
  - m_Id: 24438443376640
    m_Localized: Nach dem letzten Abprall richtet sich das Projektil direkt auf den
      Feind.
    m_Metadata:
      m_Items: []
  - m_Id: 24503975182336
    m_Localized: "Die Abklingzeiten aktiver F\xE4higkeiten werden um 20% reduziert."
    m_Metadata:
      m_Items: []
  - m_Id: 31517736468480
    m_Localized: ' ist dem Spiel beigetreten'
    m_Metadata:
      m_Items: []
  - m_Id: 60150848978944
    m_Localized: Sprache
    m_Metadata:
      m_Items: []
  - m_Id: 135706756022272
    m_Localized: "W\xC4HLE EINE F\xC4HIGKEIT"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
