    m_Metadata:
      m_Items: []
  - m_Id: 12180107591680
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041F\u0440\u043E\u0431\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0440\u044B\u0432\u043E\u043A, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 12256175489024
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041B\u0435\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0440\u044B\u0432\u043E\u043A, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
      \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 13933255360512
    m_Localized: "\u0421\u0438\u043B\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14038242983936
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041F\u0440\u043E\u0431\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0430
      1.5 \u0441\u0435\u043A\u0443\u043D\u0434, \u043D\u043E \u043D\u0430 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0442\u0432\u043E\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u0432 \u0434\u0432\u0430
      \u0440\u0430\u0437\u0430 \u0438 \u0442\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14421950496768
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041B\u0435\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0430
      1.5 \u0441\u0435\u043A\u0443\u043D\u0434, \u043D\u043E \u043D\u0430 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0442\u0432\u043E\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u0432 \u0434\u0432\u0430
      \u0440\u0430\u0437\u0430 \u0438 \u0442\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14646878437376
    m_Localized: "\u0411\u0430\u0440\u044C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 14712502517760
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041F\u0440\u043E\u0431\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0431\u043E\u0447\u043A\u0443
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0441\u043E\u0431\u043E\u0439. \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E 2 \u0441\u0442\u0435\u043D\u044B. \u041F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u0431\u043E\u0447\u043A\u0438 = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 14759189315584
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041B\u0435\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0431\u043E\u0447\u043A\u0443
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0441\u043E\u0431\u043E\u0439. \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E 2 \u0441\u0442\u0435\u043D\u044B. \u041F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u0431\u043E\u0447\u043A\u0438 = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 15150673068032
    m_Localized: "\u041F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15290817347584
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041F\u0440\u043E\u0431\u0435\u043B
      \u043F\u0435\u0440\u0435\u0434 \u0443\u0434\u0430\u0440\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0448\u0430\u0440
      \u0438 \u043E\u0442\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0435\u0433\u043E
      \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15534510604288
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u041B\u0435\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A
      \u043F\u0435\u0440\u0435\u0434 \u0443\u0434\u0430\u0440\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
