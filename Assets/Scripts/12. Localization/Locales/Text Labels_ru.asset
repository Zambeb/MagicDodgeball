  - m_Id: 496685056000
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043E\u044E
      \u0430\u0440\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 887346724864
    m_Localized: "\u042D\u0442\u043E\u0442 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439
      \u0441\u0442\u0430\u0434\u0438\u043E\u043D, \u0441 \u043B\u044E\u0431\u043E\u0432\u044C\u044E
      \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0438\u0437 \u0433\u0440\u044F\u0437\u0438
      \u0438 \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0434 \u0440\u0443\u043A\u0443, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043B\u0430\u0432\u0443 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0446\u0435\u043B\u0435\u0443\u0441\u0442\u0440\u0435\u043C\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u043C\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0443
      \u0420\u0430\u043C\u043C\u0438.\n\u0417\u0440\u0438\u0442\u0435\u043B\u0438
      \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435.\n\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1030267633664
    m_Localized: "\u0414\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044B\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0438 \u0431\u0435\u043B\u043A\u0430\u043C\u0438,
      \u044D\u0442\u0438 \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0440\u0443\u0438\u043D\u044B \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u043E\u0433\u043B\u0430\u0448\u0430\u043B\u0438\u0441\u044C \u0442\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u043F\u0435\u0441\u043D\u043E\u043F\u0435\u043D\u0438\u044F\u043C\u0438 \u0438
      \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u043C\u0438 \u043E\u0442\u0440\u044B\u0436\u043A\u0430\u043C\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u0443\u044D\u043B\u0435\u0439
      \u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u043D\u0438\u044F
      \u0434\u0435\u043C\u043E\u043D\u043E\u0432."
