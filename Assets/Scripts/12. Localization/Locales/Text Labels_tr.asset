  m_TableData:
  - m_Id: 130866249728
    m_Localized: Rammy
    m_Metadata:
      m_Items: []
  - m_Id: 367328526336
    m_Localized: Benny
    m_Metadata:
      m_Items: []
  - m_Id: 496685056000
    m_Localized: "Arenan\u0131 se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 887346724864
    m_Localized: "\"Sevgi, \xE7amur ve etrafta bulunan her \u015Fey ile yap\u0131lm\u0131\u015F
      bu kare \u015Feklindeki stadyum kat\u0131ks\u0131z kararl\u0131l\u0131k ve
      Rammy'nin m\xFChendislik yetenekleriyle ayakta duruyor.\nSeyirciler? Bi' garip.\nOrtam?
      Kusursuz. \""
    m_Metadata:
      m_Items: []
  - m_Id: 1030267633664
    m_Localized: "Hem zaman\u0131n hem sincaplar\u0131n uzun zaman \xF6nce terk etti\u011Fi
      bu ta\u015F y\u0131k\u0131nt\u0131s\u0131 arenada bir zamanlar gizemli tezah\xFCratlar
      ve b\xFCy\xFCl\xFC ge\u011Firikler yank\u0131lan\u0131yordu. \u015Eimdi ise
      duello yap\u0131p yanl\u0131\u015Fl\u0131kla bir \u015Fey yaratmal\u0131k bir
      yerden fazlas\u0131 de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 1131039981568
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 1227953569792
    m_Localized: Birinci oyuncu isim
    m_Metadata:
      m_Items: []
  - m_Id: 1319242596352
    m_Localized: "\u0130kinci oyuncu isim"
    m_Metadata:
      m_Items: []
  - m_Id: 1381280546816
    m_Localized: Berabere!
    m_Metadata:
      m_Items: []
  - m_Id: 10462284251136
    m_Localized: " raundu kazand\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 10656069484544
    m_Localized: " \u015Eampiyon!"
    m_Metadata:
      m_Items: []
  - m_Id: 10820108713984
    m_Localized: Son raunt!
    m_Metadata:
      m_Items: []
  - m_Id: 10906469433344
    m_Localized: Durduruldu
    m_Metadata:
      m_Items: []
  - m_Id: 10987302060032
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 11041261780992
    m_Localized: "Ana Men\xFCye D\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 11118176927744
    m_Localized: Hareket
    m_Metadata:
      m_Items: []
  - m_Id: 11187282280448
    m_Localized: "Ate\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 11252029751296
    m_Localized: "Ni\u015Fan Alma"
    m_Metadata:
      m_Items: []
  - m_Id: 11368786591744
    m_Localized: Klavye + Maus
    m_Metadata:
      m_Items: []
  - m_Id: 11310548680704
    m_Localized: Aktif Yetenek
    m_Metadata:
      m_Items: []
  - m_Id: 11430853902336
    m_Localized: Oyun Kolu
    m_Metadata:
      m_Items: []
  - m_Id: 11489460912128
    m_Localized: "Sol T\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 11549493985280
    m_Localized: "Bo\u015Fluk"
    m_Metadata:
      m_Items: []
  - m_Id: 11627814223872
