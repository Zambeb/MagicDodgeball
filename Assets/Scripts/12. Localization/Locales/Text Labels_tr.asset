  - m_Id: 11745489616896
    m_Localized: Sol Tetik
    m_Metadata:
      m_Items: []
  - m_Id: 11806487379968
    m_Localized: "Sa\u011F Tetik"
    m_Metadata:
      m_Items: []
  - m_Id: 11867141210112
    m_Localized: Defansif
    m_Metadata:
      m_Items: []
  - m_Id: 11932102590464
    m_Localized: Ofansif
    m_Metadata:
      m_Items: []
  - m_Id: 11990655074304
    m_Localized: Aktif
    m_Metadata:
      m_Items: []
  - m_Id: 12043696242688
    m_Localized: "Bekleme S\xFCresi"
    m_Metadata:
      m_Items: []
  - m_Id: 12103003701248
    m_Localized: "At\u0131lma"
    m_Metadata:
      m_Items: []
  - m_Id: 12180107591680
    m_Localized: "Dokunulmaz olup at\u0131lmak i\xE7in Bo\u015Fluk tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 12256175489024
    m_Localized: "Dokunulmaz olup at\u0131lmak i\xE7in Sol Tetik tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 13933255360512
    m_Localized: "G\xFC\xE7 Alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 14038242983936
    m_Localized: "1.5 saniye dokunulmaz olmak i\xE7in Bo\u015Fluk tu\u015Funa bas,
      fakat h\u0131z\u0131n x0.5 azalacak ve ate\u015F edemezsin"
    m_Metadata:
      m_Items: []
  - m_Id: 14421950496768
    m_Localized: "1.5 saniye dokunulmaz olmak i\xE7in Sol Tetik tu\u015Funa bas,
      fakat h\u0131z\u0131n x0.5 azalacak ve ate\u015F edemezsin"
    m_Metadata:
      m_Items: []
  - m_Id: 14646878437376
    m_Localized: "B\xFCy\xFC Bariyeri"
    m_Metadata:
      m_Items: []
  - m_Id: 14712502517760
    m_Localized: "Yan\u0131nda varil yaratmak i\xE7in Bo\u015Fluk tu\u015Funa bas.
      Tek seferde 2 var olabilir. Varilin can\u0131 = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 14759189315584
    m_Localized: "Yan\u0131nda varil yaratmak i\xE7in Sol Tetik tu\u015Funa bas.
      Tek seferde 2 var olabilir. Varilin can\u0131 = 5"
    m_Metadata:
      m_Items: []
  - m_Id: 15150673068032
    m_Localized: "Savu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 15290817347584
    m_Localized: "Vurulmadan \xF6nce toplar\u0131 savu\u015Fturup rakibinin alan\u0131na
      g\xF6ndermek i\xE7in Bo\u015Fluk tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 15534510604288
    m_Localized: "Vurulmadan \xF6nce toplar\u0131 savu\u015Fturup rakibinin alan\u0131na
      g\xF6ndermek i\xE7in Sol Tetik tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 15761443422208
    m_Localized: "De\u011Fi\u015F Toku\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 15843295264768
    m_Localized: "I\u015F\u0131nlanma alan\u0131 a\xE7\u0131p rakibinle yer de\u011Fi\u015Ftirmek
      i\xE7in Bo\u015Fluk tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 16053312454656
    m_Localized: "I\u015F\u0131nlanma alan\u0131 a\xE7\u0131p rakibinle yer de\u011Fi\u015Ftirmek
      i\xE7in Sol Tetik tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 16200658354176
    m_Localized: "Sekmeden sonra h\u0131zlanma"
    m_Metadata:
      m_Items: []
  - m_Id: 16300013027328
    m_Localized: "Toplar\u0131n her sekmeden sonra h\u0131z kazan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 16357957337088
    m_Localized: "Toplar\u0131 yut"
    m_Metadata:
      m_Items: []
  - m_Id: 16416090390528
    m_Localized: "\u0130ki top \xE7arp\u0131\u015Ft\u0131\u011F\u0131nda, senin yeni
      topun di\u011Ferini yutar, boyutu ve sekme miktar\u0131 artar"
    m_Metadata:
      m_Items: []
  - m_Id: 16479445352448
    m_Localized: Elektrikli Alan
    m_Metadata:
      m_Items: []
  - m_Id: 16627202293760
    m_Localized: "Son sekme elektrikli bir alan yarat\u0131r ve \xFCzerinde duranlara
      hasar vurur. B\xFCy\xFCk toplar -> b\xFCy\xFCk hasar alanlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 16728696061952
    m_Localized: "Y\xFCkl\xFC At\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 16780051120128
    m_Localized: "Sonraki topunun h\u0131z\u0131n\u0131 arrt\u0131rmak i\xE7in Sol
      T\u0131k'a bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 17089708195840
    m_Localized: "Sonraki topunun h\u0131z\u0131n\u0131 arrt\u0131rmak i\xE7in Sa\u011F
      Tetik'a bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 17275230650368
    m_Localized: "Patlay\u0131c\u0131 toplar"
    m_Metadata:
      m_Items: []
  - m_Id: 17339571273728
    m_Localized: "Toplar\u0131n son sekmeden sonra 6 k\xFC\xE7\xFCk topa d\xF6n\xFC\u015F\xFCp
      da\u011F\u0131l\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 17404377464832
    m_Localized: "Vurulduktan sonra dokunulmazl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 17471188533248
    m_Localized: 'Vurulduktan sonra 1 saniye dokunulmaz ol '
    m_Metadata:
      m_Items: []
  - m_Id: 17542382649344
    m_Localized: "Maksimum Sekme Art\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 17605557256192
    m_Localized: "Toplar\u0131na fazladan 2 sekme ekle"
    m_Metadata:
      m_Items: []
  - m_Id: 17707587895296
    m_Localized: Ekstra Toplar
    m_Metadata:
      m_Items: []
  - m_Id: 17769382576128
    m_Localized: 'Ekstra 1 top ekle '
    m_Metadata:
      m_Items: []
  - m_Id: 17829625364480
    m_Localized: "Hareket H\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 17886726619136
    m_Localized: "H\u0131z\u0131n\u0131 5 artt\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 17943144202240
    m_Localized: "Kendine Hasar\u0131 Kapat"
    m_Metadata:
      m_Items: []
  - m_Id: 18020118069248
    m_Localized: "Toplar\u0131n sana zarar veremez"
    m_Metadata:
      m_Items: []
  - m_Id: 18085901533184
    m_Localized: "Top \xD6l\xE7\xFCs\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 18169510789120
    m_Localized: "Top \xF6l\xE7\xFClerini x1.65 b\xFCy\xFCt"
    m_Metadata:
      m_Items: []
  - m_Id: 18228243628032
    m_Localized: "Top H\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18284938035200
    m_Localized: "Top h\u0131z\u0131n\u0131 4 artt\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 18340625809408
    m_Localized: Kalkan
    m_Metadata:
      m_Items: []
  - m_Id: 18397349576704
    m_Localized: "Etraf\u0131nda dolan\u0131p sald\u0131r\u0131lardan koruyan 1 kalkan
      ekle"
    m_Metadata:
      m_Items: []
  - m_Id: 18452504674304
    m_Localized: "Yava\u015Flat\u0131c\u0131 \u0130z"
    m_Metadata:
      m_Items: []
  - m_Id: 18513095589888
    m_Localized: "Toplar\u0131n \xFCzerinden ge\xE7enleri yava\u015Flatacak bir iz
      b\u0131rak\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 18565755076608
    m_Localized: Sersemlet
    m_Metadata:
      m_Items: []
  - m_Id: 18622529175552
    m_Localized: "Toplar\u0131n rakibini 0.8 saniyeli\u011Fine sersemletir"
    m_Metadata:
      m_Items: []
  - m_Id: 31517736468480
    m_Localized: " oyuna kat\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 22562327003136
    m_Localized: "\xC7\xF6p Heykeli"
    m_Metadata:
      m_Items: []
  - m_Id: 22623979077632
    m_Localized: "\xC7\xF6pten bir heykel yapmak i\xE7in Bo\u015Fluk tu\u015Funa
      bas. 3 vuru\u015Ftan sonra k\u0131r\u0131l\u0131r. Bekleme s\xFCresi 8s "
    m_Metadata:
      m_Items: []
  - m_Id: 22649002295296
    m_Localized: "\xC7\xF6pten bir heykel yapmak i\xE7in Sol Tetik tu\u015Funa bas.
      3 vuru\u015Ftan sonra k\u0131r\u0131l\u0131r. Bekleme s\xFCresi 8s "
    m_Metadata:
      m_Items: []
  - m_Id: 23374415560704
    m_Localized: "G\xFCd\xFCml\xFC Top"
    m_Metadata:
      m_Items: []
  - m_Id: 23510189375488
    m_Localized: "Toplar\u0131n yava\u015F\xE7a hareketini d\xFCiman\u0131n y\xF6n\xFCne
      g\xF6re ayarlar"
    m_Metadata:
      m_Items: []
  - m_Id: 24185417793536
    m_Localized: "Geri \u0130ttirme"
    m_Metadata:
      m_Items: []
  - m_Id: 24292196384768
    m_Localized: "Vuru\u015Fta rakibini ters y\xF6ne do\u011Fru biraz ittirir"
    m_Metadata:
      m_Items: []
  - m_Id: 24311666343936
    m_Localized: "\u0130kili at\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 24361817636864
    m_Localized: "20% \u015Fansla an\u0131nda ikinci bir at\u0131\u015F yap. Bu ekstra
      at\u0131\u015F mermi olarak say\u0131lmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 24381560225792
    m_Localized: "Son T\xFCk\xFCr\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 24438443376640
    m_Localized: "Son sekmeden sonra, top rakibe do\u011Fru gider"
    m_Metadata:
      m_Items: []
  - m_Id: 24456181088256
    m_Localized: "\xC7al\u0131\u015Fkanl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 24503975182336
    m_Localized: "Aktif yeteneklerin s\xFCresi 20% k\u0131sal\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 135706756022272
    m_Localized: "GEL\u0130\u015ET\u0130RME SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 302086516146176
    m_Localized: Oyun Sesi
    m_Metadata:
      m_Items: []
  - m_Id: 302192384573440
    m_Localized: "M\xFCzik Sesi"
    m_Metadata:
      m_Items: []
  - m_Id: 302277377949696
    m_Localized: Efekt Sesi
    m_Metadata:
      m_Items: []
  - m_Id: 60150848978944
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 360327522582528
    m_Localized: "Benny, karl\u0131 da\u011Flarda bo\u015F \u015Fi\u015Fe toplarken
      bu buzlu arenay\u0131 ke\u015Ffetti. Yerel yetiler, toplam gelirin %15\u2019i
      kar\u015F\u0131l\u0131\u011F\u0131nda buray\u0131 b\xFCy\xFCl\xFC d\xFCellolar
      i\xE7in memnuniyetle tahsis etmeyi kabul ettiler."
    m_Metadata:
      m_Items: []
  references:
    version: 2
